{
  "name": "petualang-web",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate:content": "tsx scripts/validate-content.ts",
    "check:contrast": "tsx scripts/check-contrast.ts",
